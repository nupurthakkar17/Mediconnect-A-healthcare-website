<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title>Health Tracking History | MediConnect</title>
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="page-wrap" style="max-width:640px;">
    <div class="card">
      <h1>Your Health History</h1>

      <% if (entries === null) { %>
        <p class="subtitle">Log in to see your saved history across visits.</p>
        <a href="/login" class="btn-primary" style="display:inline-block; width:auto; padding:10px 20px; text-decoration:none;">Log in</a>
      <% } else if (entries.length === 0) { %>
        <p class="subtitle">No entries yet. <a href="/health-tracking">Log your first one</a>.</p>
      <% } else { %>
        <table class="data-table">
          <thead><tr><th>Date</th><th>Steps</th><th>Water (L)</th><th>Calories</th><th>Heart Rate</th></tr></thead>
          <tbody>
            <% entries.forEach(function(e) { %>
              <tr>
                <td><%= new Date(e.logged_at).toLocaleDateString() %></td>
                <td><%= e.steps %></td>
                <td><%= e.water %></td>
                <td><%= e.calories %></td>
                <td><%= e.heart_rate %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</body>
</html>

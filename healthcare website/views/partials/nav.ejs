<header>
  <nav>
    <div class="logo"><a href="/" style="color:inherit;text-decoration:none;">MediConnect</a></div>
    <ul>
      <li><a href="/appointments">Book Appointment</a></li>
      <li><a href="/symptom">Symptom Checker</a></li>
      <li><a href="/findcare">Find Care</a></li>
      <li><a href="/medicinedelivery">Pharmacy</a></li>
      <li><a href="/health-tracking">Health Tracking</a></li>
      <li><a href="/healthreports">Health Reports</a></li>
      <% if (!user) { %>
        <li><a href="/login">Login</a></li>
        <li><a href="/signup">Sign up</a></li>
      <% } else { %>
        <li class="user-logo">
          <%
            const name = user.name || "";
            const initials = name.split(" ").map(word => word.charAt(0).toUpperCase()).join("");
          %>
          <%= initials || "U" %>
          <div class="dropdown-content">
            <a href="/logout" class="logout">Logout</a>
          </div>
        </li>
      <% } %>
    </ul>
  </nav>
</header>

<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title>Pharmacy | MediConnect</title>
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="page-wrap" style="max-width:960px;">
    <div class="card">
      <h1>Pharmacy</h1>
      <p class="subtitle">Order medicines online, delivered to your door.</p>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <div class="alert alert-error" id="cart-error" style="display:none;"></div>

      <div class="search-row">
        <input type="text" id="search-box" placeholder="Search medicines...">
        <a href="/medicinedelivery/cart" class="btn-primary" style="width:auto; padding:0 20px; display:flex; align-items:center; text-decoration:none;">
          Cart (<span id="cart-count"><%= (typeof cartCount !== 'undefined') ? cartCount : '' %></span>)
        </a>
      </div>

      <div id="product-list" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); gap:16px;">
        <% if (products && products.length > 0) { %>
          <% products.forEach(product => { %>
            <div class="card product-item" data-name="<%= product.name.toLowerCase() %>" style="padding:16px; box-shadow:none; border:1px solid var(--border);">
              <div style="width:48px;height:48px;border-radius:50%;background:var(--brand-light);color:var(--brand);display:flex;align-items:center;justify-content:center;font-weight:700;margin-bottom:10px;">
                <%= product.name.charAt(0) %>
              </div>
              <h3 style="margin:0 0 4px; font-size:1rem;"><%= product.name %></h3>
              <p style="margin:0 0 4px; color:var(--muted); font-size:0.85rem;"><%= product.category %></p>
              <p style="margin:0 0 10px; font-weight:700; color:var(--brand);">₹<%= Number(product.price).toFixed(2) %></p>
              <% if (product.stock > 0) { %>
                <button class="btn-primary add-to-cart" data-id="<%= product.id %>" data-name="<%= product.name %>">Add to Cart</button>
              <% } else { %>
                <button class="btn-primary" disabled>Out of Stock</button>
              <% } %>
            </div>
          <% }) %>
        <% } else { %>
          <p>No medicines available at the moment.</p>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    // Filters the medicines actually rendered by the server, instead of a
    // separate hardcoded product list that used to silently replace them.
    document.getElementById('search-box').addEventListener('input', function () {
      var query = this.value.toLowerCase();
      document.querySelectorAll('.product-item').forEach(function (card) {
        card.style.display = card.dataset.name.includes(query) ? '' : 'none';
      });
    });

    document.querySelectorAll('.add-to-cart').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var errorBox = document.getElementById('cart-error');
        errorBox.style.display = 'none';
        fetch('/medicinedelivery/cart', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: 'productId=' + encodeURIComponent(btn.dataset.id),
        })
          .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
          .then(function (result) {
            if (!result.ok) {
              errorBox.textContent = result.data.error || 'Could not add to cart.';
              errorBox.style.display = 'block';
              return;
            }
            document.getElementById('cart-count').textContent = result.data.cartCount;
            btn.textContent = 'Added ✓';
            setTimeout(function () { btn.textContent = 'Add to Cart'; }, 1200);
          })
          .catch(function () {
            errorBox.textContent = 'Something went wrong. Please try again.';
            errorBox.style.display = 'block';
          });
      });
    });
  </script>
</body>
</html>
